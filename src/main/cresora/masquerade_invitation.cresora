weapon "Masquerade Invitation" {
    id: "masquerade_invitation"
    rarity: "2_star"
    base_item: "minecraft:wooden_sword"
    role: medic
    stats {
        base_damage: 7.0
        damage_per_level: 0.24
        speed: 1.6
    }
    skill "Heal" {
        effect_id: "heal"
        cooldown: 30s
        duration: 0s
        base_value: 2.0
        value_per_level: 0.5
        
        on_activate {
            start_cooldown()
            execute {
                val value = WeaponCombatSupport.skillValueHp(definition, data);
                player.heal(value);
                player.sendMessage(Text.translatable("item.cresora.weapon.skill.heal_activated", Text.translatable(definition.translationKey()), WeaponSkillService.formatNumber(value / 2.0)).formatted(Formatting.GREEN), true);
            }
        }
    }
    translations {
        en_us {
            name: "Masquerade Invitation"
            skill_name: "Invitation to Healing"
            "item.cresora.weapon.skill.heal_activated.generic": "Healing Grace Activated!"
            "item.cresora.weapon.skill.heal_activated": "%s Activated! Restored %s hearts."
        }
        ja_jp {
            name: "マスカレードへの誘い"
            skill_name: "癒やしへの招待状"
            "item.cresora.weapon.skill.heal_activated.generic": "至福の癒やし 起動！"
            "item.cresora.weapon.skill.heal_activated": "%s を発動。%s ハート回復。"
        }
        zh_cn {
            name: "通往假面舞会的邀约"
            skill_name: "治愈邀请函"
            "item.cresora.weapon.skill.heal_activated.generic": "至福之愈 启动！"
            "item.cresora.weapon.skill.heal_activated": "%s 已发动。恢复 %s 心。"
        }
        lzh {
            name: "假面盛筵之邀"
            skill_name: "治愈邀请函"
            "item.cresora.weapon.skill.heal_activated.generic": "至福之愈 啓矣！"
            "item.cresora.weapon.skill.heal_activated": "%s 已發。療 %s 心。"
        }
    }
}
