weapon "Tanboku Chokuu" {
    id: "tanboku_chokuu"
    rarity: "5_star"
    base_item: "minecraft:diamond_sword"
    custom_model_data: 10101
    damage_type: physical
    role: guard
    stats {
        base_damage: 9.0
        damage_per_level: 0.1
        speed: 1.6
        max_base_level: 60
        max_skill_level: 10
    }
    spirit {
        name: "item.cresora-utilities.tanboku_chokuu"
        awakening_condition: "spirit.cresora.tanboku_chokuu.awakening"
        voice_lines {
            first_contact: "spirit.cresora.tanboku_chokuu.voice.first_contact"
        }
        bond_stage 1 {
            title: "spirit.cresora.tanboku_chokuu.bond.1.title"
            story: "spirit.cresora.tanboku_chokuu.bond.1.story"
        }
        bond_stage 2 {
            title: "spirit.cresora.tanboku_chokuu.bond.2.title"
            story: "spirit.cresora.tanboku_chokuu.bond.2.story"
        }
        bond_stage 3 {
            title: "spirit.cresora.tanboku_chokuu.bond.3.title"
            story: "spirit.cresora.tanboku_chokuu.bond.3.story"
        }
        bond_stage 4 {
            title: "spirit.cresora.tanboku_chokuu.bond.4.title"
            story: "spirit.cresora.tanboku_chokuu.bond.4.story"
        }
        bond_stage 5 {
            title: "spirit.cresora.tanboku_chokuu.bond.5.title"
            story: "spirit.cresora.tanboku_chokuu.bond.5.story"
        }
        bond_stage 6 {
            title: "spirit.cresora.tanboku_chokuu.bond.6.title"
            story: "spirit.cresora.tanboku_chokuu.bond.6.story"
        }
    }

    // メインスキル：メニュー展開
    skill "Rougan Kenpo" {
        effect_id: "rougan_kenpo"
        note: "melody"
        cooldown: 3s
        radius: 5.0

        buff "zanso_active" {
            max_stacks: 1
            duration: 15s
        }
        buff "munen_seq" {
            max_stacks: 8
            duration: 5s
        }

        on_activate {
            execute {
                WeaponSkillService.addTao(player, 1);
                player.sendMessage(Text.translatable("item.cresora.weapon.tanboku_chokuu.tao_gained", WeaponSkillService.getTao(player)).formatted(Formatting.GOLD), true);
            }
            open_skill_menu("danro", "zanso", "bokuchu_munen", 3s)
        }

        on_damage_dealt {
            execute {
                val stacks = WeaponSkillService.getSoulBreakStacks(target);
                if (stacks > 0 && !isTrueDamage) {
                    val boost = amount * (stacks * 0.04f);
                    target.damage(player.world, player.world.damageSources.magic(), boost);
                    if (player.world.time % 20L == 0L) {
                         player.sendMessage(Text.translatable("item.cresora.weapon.tanboku_chokuu.soul_break", stacks, stacks * 5, stacks * 4).formatted(Formatting.GRAY), true);
                    }
                }
            }
        }
    }

    // 第一式：断露
    sub_skill "Danro" {
        effect_id: "danro"
        icon: "minecraft:iron_sword"

        on_activate {
            execute {
                val world = player.world as? ServerWorld ?: return@execute;
                val dir = player.rotationVecClient.multiply(1.0, 0.0, 1.0).normalize();

                val hitBox = player.boundingBox.stretch(dir.multiply(5.0)).expand(1.0);
                world.getOtherEntities(player, hitBox) { it is LivingEntity && it.isAlive }
                    .forEach { entity ->
                        val target = entity as LivingEntity;
                        val damage = WeaponCombatSupport.attackDamage(definition, data).toFloat();
                        target.damage(world, world.damageSources.playerAttack(player), damage);
                        WeaponSkillService.applySoulBreak(target, 1, 200L);
                        world.spawnParticles(ParticleTypes.CRIT, target.x, target.y + 1, target.z, 5, 0.2, 0.2, 0.2, 0.1);
                    }

                WeaponSkillService.addTao(player, 1);
                WeaponSkillService.startCooldown(player, "tanboku_chokuu", 60L);
            }
            send_localized_message("item.cresora.weapon.tanboku_chokuu.danro_activated", "WHITE")
            close_skill_menu()
        }
    }

    // 第二式：斬霜
    sub_skill "Zanso" {
        effect_id: "zanso"
        icon: "minecraft:iron_axe"

        on_activate {
            execute {
                if (!WeaponSkillService.consumeTao(player, 3)) {
                    zansoActiveStates.remove(player.uuid);
                    player.sendMessage(Text.translatable("item.cresora.weapon.tanboku_chokuu.tao_insufficient", 3).formatted(Formatting.RED), true);
                    return@execute;
                }

                val now = WeaponSkillService.currentWorldTime(player);
                val state = zansoActiveStates.getOrPut(player.uuid) { ZansoActiveState(0L, 0) };
                state.expireTick = now + 15 * 20L;
                state.stacks = 1;
                WeaponSkillService.startCooldown(player, "tanboku_chokuu", 300L);
                player.sendMessage(Text.translatable("item.cresora.weapon.tanboku_chokuu.zanso_activated").formatted(Formatting.AQUA), true);
                close_skill_menu()
            }
        }

        on_player_tick {
            execute {
                val now = WeaponSkillService.currentWorldTime(player);
                val state = zansoActiveStates.get(player.uuid);
                if (state != null && now < state.expireTick) {
                    if (now % 30L == 0L) {
                        val world = player.world as? ServerWorld ?: return@execute;
                        world.getOtherEntities(player, player.boundingBox.expand(3.0)) { it is LivingEntity && it.isAlive }
                            .forEach { entity ->
                                val target = entity as LivingEntity;
                                val baseDamage = WeaponCombatSupport.attackDamage(definition, data).toFloat();
                                target.damage(world, world.damageSources.playerAttack(player), baseDamage * 0.5f);
                                target.damage(world, world.damageSources.magic(), baseDamage * 0.5f);

                                if (target.health / target.maxHealth < 0.10f && !((target as? AdventureRankMobAccess)?.cresoraIsEliteMob() ?: false)) {
                                    target.kill(world);
                                    player.sendMessage(Text.translatable("item.cresora.weapon.tanboku_chokuu.zanso_instakill").formatted(Formatting.DARK_RED), true);
                                }
                                world.spawnParticles(ParticleTypes.SNOWFLAKE, target.x, target.y + 1, target.z, 3, 0.1, 0.1, 0.1, 0.05);
                            }
                    }
                }
            }
        }
    }

    // 第三式：墨中無念
    sub_skill "Bokuchu Munen" {
        effect_id: "bokuchu_munen"
        icon: "minecraft:netherite_sword"

        on_activate {
            execute {
                val world = player.world as? ServerWorld ?: return@execute;
                if (!WeaponSkillService.consumeTao(player, 7)) {
                    munenSeqStates.remove(player.uuid);
                    player.sendMessage(Text.translatable("item.cresora.weapon.tanboku_chokuu.tao_insufficient", 7).formatted(Formatting.RED), true);
                    return@execute;
                }

                WeaponSkillService.grantInvulnerability(player, 60L);
                val target = world.getOtherEntities(player, player.boundingBox.expand(10.0)) { it is LivingEntity && it.isAlive }
                    .filterIsInstance<LivingEntity>()
                    .maxByOrNull { it.health } ?: run {
                        WeaponSkillService.addTao(player, 7);
                        munenSeqStates.remove(player.uuid);
                    return@execute;
                };

                val now = WeaponSkillService.currentWorldTime(player);
                val state = munenSeqStates.getOrPut(player.uuid) { MunenSeqState(0L, 0) };
                state.expireTick = now + 5 * 20L;
                state.stacks = 0;
                WeaponSkillService.applyMark(target, "munen_target_" + player.uuid, 100L);
                WeaponSkillService.startCooldown(player, "tanboku_chokuu", 600L);
                player.sendMessage(Text.translatable("item.cresora.weapon.tanboku_chokuu.munen_activated").formatted(Formatting.DARK_PURPLE), true);
                close_skill_menu()
            }
        }

        on_player_tick {
            execute {
                val now = WeaponSkillService.currentWorldTime(player);
                val state = munenSeqStates.get(player.uuid);
                if (state != null && now < state.expireTick) {
                    if (now % 6L == 0L) {
                        val world = player.world as? ServerWorld ?: return@execute;
                        val markId = "munen_target_" + player.uuid;
                        val target = world.getOtherEntities(null, player.boundingBox.expand(16.0)) { it is LivingEntity && it.isAlive && WeaponSkillService.hasMark(it, markId) }
                            .firstOrNull() as? LivingEntity;

                        if (target == null) {
                            munenSeqStates.remove(player.uuid);
                            return@execute;
                        }

                        val hit = state.stacks;
                        if (hit <= 6) {
                            val damage = WeaponCombatSupport.attackDamage(definition, data).toFloat();
                            target.damage(world, world.damageSources.playerAttack(player), damage);
                            state.stacks += 1;
                            world.spawnParticles(ParticleTypes.SWEEP_ATTACK, target.x, target.y + 1, target.z, 1, 0.0, 0.0, 0.0, 0.0);
                        } else if (hit == 7) {
                            val trueDamage = target.maxHealth * 0.15f;
                            WeaponSkillService.dealTrueDamage(player, target, trueDamage);
                            player.sendMessage(Text.translatable("item.cresora.weapon.tanboku_chokuu.munen_final", WeaponSkillService.formatNumber(trueDamage.toDouble() / 2.0)).formatted(Formatting.LIGHT_PURPLE), true);

                            munenSeqStates.remove(player.uuid);
                            WeaponSkillService.removeMark(target, markId);
                            world.spawnParticles(ParticleTypes.EXPLOSION, target.x, target.y + 1, target.z, 1, 0.0, 0.0, 0.0, 0.0);
                        }
                    }
                }
            }
        }
    }

    translations {
        en_us {
            name: "Tanboku Chokuu"
            skill_name: "Rougan Sword Styles"
            "spirit.cresora.tanboku_chokuu.awakening": "Awakens when breath, ink, and blade finally move as one intention."
            "spirit.cresora.tanboku_chokuu.voice.first_contact": "Do not chase the blade. Empty the heart, and the edge will arrive by itself."
            "spirit.cresora.tanboku_chokuu.bond.1.title": "Ink Unsettled"
            "spirit.cresora.tanboku_chokuu.bond.1.story": "His presence first appears like a stroke left half-finished, severe but searching."
            "spirit.cresora.tanboku_chokuu.bond.2.title": "Dew-Cutting Form"
            "spirit.cresora.tanboku_chokuu.bond.2.story": "Technique becomes more than precision; it becomes a way to remove what clouds your mind."
            "spirit.cresora.tanboku_chokuu.bond.3.title": "Frost Listening"
            "spirit.cresora.tanboku_chokuu.bond.3.story": "He begins to hear the silence between your choices and corrects you without humiliation."
            "spirit.cresora.tanboku_chokuu.bond.4.title": "Empty Stroke"
            "spirit.cresora.tanboku_chokuu.bond.4.story": "What looked like austerity reveals itself as mercy: the strength to cut only what must be cut."
            "spirit.cresora.tanboku_chokuu.bond.5.title": "Vast Sky in Ink"
            "spirit.cresora.tanboku_chokuu.bond.5.story": "His discipline opens rather than narrows, making space for conviction that does not waver."
            "spirit.cresora.tanboku_chokuu.bond.6.title": "Blade Beyond Thought"
            "spirit.cresora.tanboku_chokuu.bond.6.story": "At last he trusts your hand enough to let instinct stand where doctrine once ruled."
            sub_skill_danro_name: "First Style: Danro"
            sub_skill_zanso_name: "Second Style: Zanso"
            sub_skill_bokuchu_munen_name: "Third Style: Munen"
            "item.cresora.weapon.tanboku_chokuu.tao_gained": "Tao +1 (Total %s)"
            "item.cresora.weapon.tanboku_chokuu.tao_insufficient": "Insufficient Tao (Need %s)"
            "item.cresora.weapon.tanboku_chokuu.soul_break": "Soul Break %s | PHYS RES -%s%% | DEF -%s%%"
            "item.cresora.weapon.tanboku_chokuu.danro_activated": "First Style: Danro — Sword Qi released!"
            "item.cresora.weapon.tanboku_chokuu.zanso_activated": "Second Style: Zanso — Frost Field active!"
            "item.cresora.weapon.tanboku_chokuu.zanso_instakill": "Frost cut — Instakill!"
            "item.cresora.weapon.tanboku_chokuu.munen_activated": "Third Style: Munen — Seven celestial cuts!"
            "item.cresora.weapon.tanboku_chokuu.munen_final": "Final Cut! True Damage: %s hearts"
        }
        ja_jp {
            name: "淡墨長空"
            skill_name: "琅玕剣法"
            "spirit.cresora.tanboku_chokuu.awakening": "息と墨と刃が、ようやくひとつの意志として揃った時に目覚める。"
            "spirit.cresora.tanboku_chokuu.voice.first_contact": "刃を追うな。心を空にすれば、切っ先のほうから訪れる。"
            "spirit.cresora.tanboku_chokuu.bond.1.title": "揺れる墨"
            "spirit.cresora.tanboku_chokuu.bond.1.story": "彼の気配は、描き終える前に止められた一筆のように、峻厳でありながら何かを探している。"
            "spirit.cresora.tanboku_chokuu.bond.2.title": "露を断つ型"
            "spirit.cresora.tanboku_chokuu.bond.2.story": "技はただの正確さではなく、心を曇らせるものを払い落とす術へ変わる。"
            "spirit.cresora.tanboku_chokuu.bond.3.title": "霜を聴く"
            "spirit.cresora.tanboku_chokuu.bond.3.story": "彼はあなたの選択のあいだにある沈黙を聞き取り、辱めることなく矯めてくれる。"
            "spirit.cresora.tanboku_chokuu.bond.4.title": "空なる一閃"
            "spirit.cresora.tanboku_chokuu.bond.4.story": "厳しさに見えたものは慈悲だったと知る。斬るべきものだけを斬る力なのだと。"
            "spirit.cresora.tanboku_chokuu.bond.5.title": "墨にひらく長空"
            "spirit.cresora.tanboku_chokuu.bond.5.story": "彼の鍛錬は狭めるのではなく、揺るがぬ決意が立つだけの広さをひらいていく。"
            "spirit.cresora.tanboku_chokuu.bond.6.title": "念を越える刃"
            "spirit.cresora.tanboku_chokuu.bond.6.story": "ついに彼は、教えの代わりに本能を託せるほど、あなたの手を信じるようになる。"
            sub_skill_danro_name: "第一式：断露"
            sub_skill_zanso_name: "第二式：斬霜"
            sub_skill_bokuchu_munen_name: "第三式：墨中無念"
            "item.cresora.weapon.tanboku_chokuu.tao_gained": "道を獲得：現在 %s層"
            "item.cresora.weapon.tanboku_chokuu.tao_insufficient": "道が足りません（必要：%s層）"
            "item.cresora.weapon.tanboku_chokuu.soul_break": "破魂 %s層 | 物理耐性 -%s%% | 防御力 -%s%%"
            "item.cresora.weapon.tanboku_chokuu.danro_activated": "第一式：断露 — 二条の剣気が迸る！"
            "item.cresora.weapon.tanboku_chokuu.zanso_activated": "第二式：斬霜 — 周囲に霜の領域を展開！"
            "item.cresora.weapon.tanboku_chokuu.zanso_instakill": "霜刃に絶えたり（即死）"
            "item.cresora.weapon.tanboku_chokuu.munen_activated": "第三式：墨中無念 — 無念の七連撃！"
            "item.cresora.weapon.tanboku_chokuu.munen_final": "終撃！確定ダメージ：%s ハート"
        }
        zh_cn {
            name: "淡墨长空"
            skill_name: "琅玕剑法"
            "spirit.cresora.tanboku_chokuu.awakening": "当呼吸、墨意与剑锋终于化为同一个意志时，他便苏醒。"
            "spirit.cresora.tanboku_chokuu.voice.first_contact": "不要追着剑走。心若空了，锋刃自会来到你手中。"
            "spirit.cresora.tanboku_chokuu.bond.1.title": "未定之墨"
            "spirit.cresora.tanboku_chokuu.bond.1.story": "他的气息像一笔未竟的墨痕，严厉，却仍在寻找落点。"
            "spirit.cresora.tanboku_chokuu.bond.2.title": "断露之式"
            "spirit.cresora.tanboku_chokuu.bond.2.story": "技法不再只是准确，而成了替你斩去心中浑浊的方式。"
            "spirit.cresora.tanboku_chokuu.bond.3.title": "听霜"
            "spirit.cresora.tanboku_chokuu.bond.3.story": "他开始听懂你选择之间的沉默，并在不伤你颜面的情况下纠正偏差。"
            "spirit.cresora.tanboku_chokuu.bond.4.title": "空笔一划"
            "spirit.cresora.tanboku_chokuu.bond.4.story": "你终于明白，那份看似冷硬的克制，其实是只斩必须斩之物的慈悲。"
            "spirit.cresora.tanboku_chokuu.bond.5.title": "墨开长空"
            "spirit.cresora.tanboku_chokuu.bond.5.story": "他的修行不是收紧，而是替你打开一片足以容纳信念的天空。"
            "spirit.cresora.tanboku_chokuu.bond.6.title": "念外之刃"
            "spirit.cresora.tanboku_chokuu.bond.6.story": "最终，他信任你的手，信任到愿让本能立在教条曾站的位置。"
            sub_skill_danro_name: "第一式：断露"
            sub_skill_zanso_name: "第二式：斩霜"
            sub_skill_bokuchu_munen_name: "第三式：墨中无念"
            "item.cresora.weapon.tanboku_chokuu.tao_gained": "获得「道」：当前 %s 层"
            "item.cresora.weapon.tanboku_chokuu.tao_insufficient": "「道」不足（需要 %s 层）"
            "item.cresora.weapon.tanboku_chokuu.soul_break": "破魂 %s 层 | 物理抗性 -%s%% | 防御力 -%s%%"
            "item.cresora.weapon.tanboku_chokuu.danro_activated": "第一式：断露 — 剑气迸发！"
            "item.cresora.weapon.tanboku_chokuu.zanso_activated": "第二式：斩霜 — 展开霜之领域！"
            "item.cresora.weapon.tanboku_chokuu.zanso_instakill": "霜刃绝命（即死）"
            "item.cresora.weapon.tanboku_chokuu.munen_activated": "第三式：墨中无念 — 无念七连击！"
            "item.cresora.weapon.tanboku_chokuu.munen_final": "终击！真实伤害：%s 心"
        }
        lzh {
            name: "淡墨長空"
            skill_name: "琅玕劍法"
            "spirit.cresora.tanboku_chokuu.awakening": "息、墨、刃既合為一志，其靈乃寤。"
            "spirit.cresora.tanboku_chokuu.voice.first_contact": "勿逐刃而行。心苟能虛，鋒自至焉。"
            "spirit.cresora.tanboku_chokuu.bond.1.title": "未定之墨"
            "spirit.cresora.tanboku_chokuu.bond.1.story": "其氣若未竟之一筆，嚴而猶有所尋。"
            "spirit.cresora.tanboku_chokuu.bond.2.title": "斷露之式"
            "spirit.cresora.tanboku_chokuu.bond.2.story": "技不徒為準，乃成去爾心翳之道。"
            "spirit.cresora.tanboku_chokuu.bond.3.title": "聽霜"
            "spirit.cresora.tanboku_chokuu.bond.3.story": "彼能聞爾抉擇間之默，而不辱其顏以正其偏。"
            "spirit.cresora.tanboku_chokuu.bond.4.title": "空筆"
            "spirit.cresora.tanboku_chokuu.bond.4.story": "貌若峻厲者，實慈也，惟斬所當斬。"
            "spirit.cresora.tanboku_chokuu.bond.5.title": "墨開長空"
            "spirit.cresora.tanboku_chokuu.bond.5.story": "其修非收束也，乃為爾闢可容定志之天。"
            "spirit.cresora.tanboku_chokuu.bond.6.title": "念外之刃"
            "spirit.cresora.tanboku_chokuu.bond.6.story": "終則信爾之手，至能使本能立於教法昔所據之地。"
            sub_skill_danro_name: "第一式：斷露"
            sub_skill_zanso_name: "第二式：斬霜"
            sub_skill_bokuchu_munen_name: "第三式：墨中無念"
            "item.cresora.weapon.tanboku_chokuu.tao_gained": "得「道」：今 %s 重"
            "item.cresora.weapon.tanboku_chokuu.tao_insufficient": "「道」不足（需 %s 重）"
            "item.cresora.weapon.tanboku_chokuu.soul_break": "破魂 %s 重 | 禦形 -%s%% | 禦 -%s%%"
            "item.cresora.weapon.tanboku_chokuu.danro_activated": "第一式：斷露 — 劍氣既發！"
            "item.cresora.weapon.tanboku_chokuu.zanso_activated": "第二式：斬霜 — 霜之界既啟！"
            "item.cresora.weapon.tanboku_chokuu.zanso_instakill": "霜刃絶命（即死）"
            "item.cresora.weapon.tanboku_chokuu.munen_activated": "第三式：墨中無念 — 無念七連擊！"
            "item.cresora.weapon.tanboku_chokuu.munen_final": "終擊！定傷：%s 心"
        }
    }
}
