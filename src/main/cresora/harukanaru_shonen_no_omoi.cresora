weapon "Thoughts of the Distant Boy" {
    id: "harukanaru_shonen_no_omoi"
    rarity: "5_star"
    base_item: "minecraft:netherite_sword"
    damage_type: arcane
    role: specialist
    stats {
        base_damage: 10.0
        damage_per_level: 0.08
        speed: 1.6
        max_base_level: 60
        max_skill_level: 10
    }
    skill "Heavy Thoughts" {
        effect_id: "harukanaru_shonen_no_omoi"
        cooldown: 35s
        duration: 5s
        base_value: 10.0
        value_per_level: 0.0
        radius: 8.0

        buff "passive_stats" {
            max_stacks: 1
            duration: 9999s
            stats {
                crit_dmg_per_stack: 10.0
                all_dmg_percent_per_stack: 10.0
            }
        }

        buff "shojo_resolve" {
            max_stacks: 1
            duration: 9999s
            stats {
                crit_dmg_per_stack: 60.0
                all_dmg_percent_per_stack: 25.0
                crit_rate_per_stack: 5.0
            }
        }

        on_activate {
            execute {
                val isGriefActive = WeaponSkillService.hasMark(player, "nageki");
                if (isGriefActive) {
                    // Pattern A
                    WeaponSkillService.startCooldown(player, definition.id, 200L);
                    WeaponSkillService.showCooldownBar(player, definition);
                    
                    val shieldHearts = 10.0 + (data.baseLevel - 1) * 0.5;
                    WeaponSkillService.grantShield(player, (shieldHearts * 2.0).toFloat(), 99999999L, definition.id);
                    
                    player.sendMessage(
                        Text.translatable(
                            "item.cresora.weapon.skill.harukanaru_shonen_no_omoi.pattern_a",
                            WeaponSkillService.formatNumber(shieldHearts)
                        ).formatted(Formatting.AQUA),
                        true
                    );
                } else {
                    // Pattern B
                    WeaponSkillService.startCooldown(player, definition.id, 700L);
                    WeaponSkillService.showCooldownBar(player, definition);
                    
                    val world = player.world as? ServerWorld ?: return@execute;
                    val range = definition.skill.radiusMeters;
                    val targets = world.getOtherEntities(player, player.boundingBox.expand(range)) {
                        it is LivingEntity &&
                        it.isAlive &&
                        it !is PlayerEntity
                    }
                    .filterIsInstance<LivingEntity>()
                    .sortedBy { it.squaredDistanceTo(player) }
                    .take(5);

                    val playerAtk = player.getAttributeValue(EntityAttributes.ATTACK_DAMAGE);
                    val damageAmount = (playerAtk * (3.0 + data.skillLevel * 0.5)).toFloat();

                    targets.forEach { target ->
                        target.damage(
                            world,
                            world.damageSources.indirectMagic(player, player),
                            damageAmount
                        );
                        world.spawnParticles(
                            ParticleTypes.CRIT,
                            target.x, target.y + 1.0, target.z,
                            5, 0.3, 0.3, 0.3, 0.1
                        );
                    }

                    player.sendMessage(
                        Text.translatable(
                            "item.cresora.weapon.skill.harukanaru_shonen_no_omoi.pattern_b",
                            targets.size,
                            WeaponSkillService.formatNumber(damageAmount.toDouble())
                        ).formatted(Formatting.LIGHT_PURPLE),
                        true
                    );
                }
            }
        }

        on_player_tick {
            execute {
                val passiveState = passiveStatsStates.getOrPut(player.uuid) { PassiveStatsState(0L, 0) };
                passiveState.expireTick = now + 100 * 20L;
                passiveState.stacks = 1;

                val hasShojo = WeaponSkillService.hasWeaponInInventory(player, "harukanaru_shojo_no_ketsui");
                if (hasShojo) {
                    if (WeaponSkillService.hasMark(player, "nageki")) {
                        WeaponSkillService.removeMark(player, "nageki");
                        val access = player as? WeaponSkillAccess;
                        if (access != null && access.cresoraGetShieldWeaponId() == definition.id) {
                            WeaponSkillService.clearShield(player);
                        }
                    }
                    
                    val resolveState = shojoResolveStates.getOrPut(player.uuid) { ShojoResolveState(0L, 0) };
                    resolveState.expireTick = now + 100 * 20L;
                    resolveState.stacks = 1;
                } else {
                    WeaponSkillService.applyMark(player, "nageki", 10L);
                    shojoResolveStates.remove(player.uuid);

                    if (now % 200L == 0L) {
                        val access = player as? WeaponSkillAccess;
                        if (access != null) {
                            val currentShield = access.cresoraGetShieldHp();
                            if (currentShield < 6.0f) {
                                if (player.random.nextDouble() < 0.5) {
                                    WeaponSkillService.grantShield(player, 6.0f, 99999999L, definition.id);
                                    player.sendMessage(
                                        Text.translatable("item.cresora.weapon.skill.harukanaru_shonen_no_omoi.grief_shield_gained")
                                            .formatted(Formatting.BLUE),
                                        true
                                    );
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    translations {
        en_us {
            name: "Thoughts of the Distant Boy"
            skill_name: "Heavy Thoughts"
            "item.cresora-utilities.harukanaru_shonen_no_omoi.skill.desc": "Heavy Thoughts: Grants passive stats (+10% CRIT DMG/DMG bonus). If 'Resolve of the Distant Girl' is in inventory, upgrades stats to (+60% CRIT DMG, +25% DMG bonus, +5% CRIT Rate). Otherwise, inflicts Grief (ATK -50%, DEF +100%, converts damage to arcane, grants shields periodically). Active: Pattern A (Grief active) grants a massive shield. Pattern B (Grief inactive) strikes up to 5 enemies dealing arcane damage."
            "item.cresora.weapon.skill.harukanaru_shonen_no_omoi.pattern_a": "Heavy Thoughts (Pattern A): Gained a %s-heart shield."
            "item.cresora.weapon.skill.harukanaru_shonen_no_omoi.pattern_b": "Heavy Thoughts (Pattern B): Struck %s enemies for %s arcane damage!"
            "item.cresora.weapon.skill.harukanaru_shonen_no_omoi.grief_shield_gained": "Passive: Grief granted a 3-heart shield!"
            "item.cresora.weapon.skill.buff.passive_stats.name": "Boy's Thoughts"
            "item.cresora.weapon.skill.buff.shojo_resolve.name": "Resolve of the Couple"
        }
        ja_jp {
            name: "遥かなる少年の想い"
            skill_name: "重き想い"
            "item.cresora-utilities.harukanaru_shonen_no_omoi.skill.desc": "重き想い：パッシブ効果（会心ダメージ・与ダメージ+10%）を獲得。インベントリに「遥かなる少女の決意」がある場合、効果が「二人の決意」（会心ダメージ+60%、与ダメージ+25%、会心率+5%）に強化される。ない場合、「嘆き」状態（攻击力-50%、防御力+100%、術ダメージ変換、10秒毎に確率でシールド獲得）になる。アクティブ：【パターンA（「嘆き」状態）】強力なシールドを獲得。【パターンB（通常）】周囲の最大5体の敵に強力な術ダメージを与える。"
            "item.cresora.weapon.skill.harukanaru_shonen_no_omoi.pattern_a": "重き想い（パターンA）: %sハート of シールドを獲得しました。"
            "item.cresora.weapon.skill.harukanaru_shonen_no_omoi.pattern_b": "重き想い（パターンB）: %s体の敵に%sの術ダメージを与えました！"
            "item.cresora.weapon.skill.harukanaru_shonen_no_omoi.grief_shield_gained": "パッシブ: 嘆きの効果により3ハートのシールドを獲得しました！"
            "item.cresora.weapon.skill.buff.passive_stats.name": "少年の想い"
            "item.cresora.weapon.skill.buff.shojo_resolve.name": "二人の決意"
        }
        zh_cn {
            name: "遥远少年的思念"
            skill_name: "沉重思念"
            "item.cresora-utilities.harukanaru_shonen_no_omoi.skill.desc": "沉重思念：获得被动加成（暴击伤害/全伤害+10%）。若背包中持有「遥远少女的决意」，则升级为「双向奔赴」（暴击伤害+60%、全伤害+25%、暴击率+5%）；否则陷入「叹息」状态（攻击力-50%、防御力+100%、非确定伤害转为术能伤害、每10秒概率获得护盾）。主动释放：【模式A（叹息状态）】获得大量护盾；【模式B（普通状态）】对周围最多5个敌人造成大量术能伤害。"
            "item.cresora.weapon.skill.harukanaru_shonen_no_omoi.pattern_a": "沉重思念（模式A）：获得 %s 颗心的护盾。"
            "item.cresora.weapon.skill.harukanaru_shonen_no_omoi.pattern_b": "沉重思念（模式B）：对 %s 个目标造成了 %s 点术能伤害！"
            "item.cresora.weapon.skill.harukanaru_shonen_no_omoi.grief_shield_gained": "被动：叹息的效果使你获得了 3 颗心的护盾！"
            "item.cresora.weapon.skill.buff.passive_stats.name": "少年的思念"
            "item.cresora.weapon.skill.buff.shojo_resolve.name": "双向奔赴"
        }
        lzh {
            name: "遙遠少年之思"
            skill_name: "重思"
            "item.cresora-utilities.harukanaru_shonen_no_omoi.skill.desc": "重思：得被動增益（會心傷與全傷加一成）。若囊中有「遙遠少女之決意」，則升為「二心合一」（會心傷加六成、全傷加兩成半、會心率加半成）；否則入「歎息」之境（攻減半，防禦加倍，傷化術能，十秒內概率得盾）。主動釋放：【其一（歎息）】得重盾；【其二（普通）】擊周遭五敵，施大術能傷。"
            "item.cresora.weapon.skill.harukanaru_shonen_no_omoi.pattern_a": "重思（其一）：得 %s 心之盾。"
            "item.cresora.weapon.skill.harukanaru_shonen_no_omoi.pattern_b": "重思（其二）：施術傷於 %s 敵（傷：%s）！"
            "item.cresora.weapon.skill.harukanaru_shonen_no_omoi.grief_shield_gained": "被動：因歎息之故，得三心之盾！"
            "item.cresora.weapon.skill.buff.passive_stats.name": "少年之思"
            "item.cresora.weapon.skill.buff.shojo_resolve.name": "二心合一"
        }
    }
}
