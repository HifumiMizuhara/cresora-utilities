            "item.cresora.weapon.skill.buff.jingtian_state.gained": "第一式「断雷」: %s 开启 (%s 层)"
        }
        lzh {
            name: "千秋，葉落"
            skill_name: "琅玕劍法"
            fragment_name: "千秋之片"
            sub_skill_danrai_name: "第一式：斷雷"
            sub_skill_zansou_name: "第二式：斬霜"
            sub_skill_yoraku_manchisho_name: "第三式：葉落滿地傷"
