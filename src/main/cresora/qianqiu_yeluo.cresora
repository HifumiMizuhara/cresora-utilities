            buff_zansou_mode_name: "斬霜"
            buff_yoraku_power_name: "叶落"
            "item.cresora.weapon.skill.buff.passive_state.gained": "効果獲得: %s"
            "item.cresora.weapon.skill.buff.jingtian_state.gained": "第一式「断雷」: %s 展開 (%s 層)"
        }
        zh_cn {
            name: "千秋、叶落"
            skill_name: "琅玕剑法"
