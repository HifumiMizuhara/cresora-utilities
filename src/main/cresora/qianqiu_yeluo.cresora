weapon "Qianqiu, Yeluo" {
    id: "qianqiu_yeluo"
    rarity: "5_star"
    base_item: "minecraft:diamond_sword"
    custom_model_data: 10103
    damage_type: arcane
    role: caster
    stats {
        base_damage: 9.0
        damage_per_level: 0.16
        speed: 1.6
        max_base_level: 60
        max_skill_level: 10
        crit_rate_bonus: 5.0
    }
    spirit {
        name: "item.cresora-utilities.qianqiu_yeluo"
        awakening_condition: "spirit.cresora.qianqiu_yeluo.awakening"
        voice_lines {
            first_contact: "spirit.cresora.qianqiu_yeluo.voice.first_contact"
        }
        bond_stage 1 {
            title: "spirit.cresora.qianqiu_yeluo.bond.1.title"
            story: "spirit.cresora.qianqiu_yeluo.bond.1.story"
        }
        bond_stage 2 {
            title: "spirit.cresora.qianqiu_yeluo.bond.2.title"
            story: "spirit.cresora.qianqiu_yeluo.bond.2.story"
        }
        bond_stage 3 {
            title: "spirit.cresora.qianqiu_yeluo.bond.3.title"
            story: "spirit.cresora.qianqiu_yeluo.bond.3.story"
        }
        bond_stage 4 {
            title: "spirit.cresora.qianqiu_yeluo.bond.4.title"
            story: "spirit.cresora.qianqiu_yeluo.bond.4.story"
        }
        bond_stage 5 {
            title: "spirit.cresora.qianqiu_yeluo.bond.5.title"
            story: "spirit.cresora.qianqiu_yeluo.bond.5.story"
        }
        bond_stage 6 {
            title: "spirit.cresora.qianqiu_yeluo.bond.6.title"
            story: "spirit.cresora.qianqiu_yeluo.bond.6.story"
        }
    }

    skill "Qianqiu Yeluo" {
        effect_id: "qianqiu_yeluo"
        cooldown: 0s

        buff "passive_state" {
            max_stacks: 1
            duration: 40s
        }

        buff "qiucan_stack" {
            max_stacks: 40
            duration: 300s
        }

        buff "jingtian_state" {
            max_stacks: 1
            duration: 40s
        }

        buff "zansou_mode" {
            max_stacks: 1
            duration: 50s
        }

        buff "yoraku_manchisho_active" {
            max_stacks: 1
            duration: 60s
        }

        // 技能③による累積強化
        buff "yoraku_power" {
            max_stacks: 100
            duration: 60s
            stats {
                attack_percent_per_stack: 2.5
                crit_dmg_per_stack: 1.5
            }
        }

        on_activate {
            add_buff("qiucan_stack", 1)
            open_skill_menu("danrai", "zansou", "yoraku_manchisho", 3s)
        }

        on_damage_taken {
            execute {
                var finalAmount = amount
                if (WeaponSkillService.hasStatus(player, "passive_state")) {
                    finalAmount *= 0.40f
                }
                if (WeaponSkillService.hasStatus(player, "yoraku_manchisho_active")) {
                    if (finalAmount >= player.health) {
                        finalAmount = (player.health - 1.0f).coerceAtLeast(0.0f)
                    }
                }
                return@execute finalAmount
            }
        }

        on_player_tick {
            execute {
                val now = WeaponSkillService.currentWorldTime(player)
                val passive = passiveStateStates.get(player.uuid)
                if (passive != null) {
                    if (!WeaponSkillService.hasStatus(player, "zansou_mode")) {
                        if (now % 40L == 0L && player.health / player.maxHealth > 0.30f) {
                            val damage = player.maxHealth * 0.02f
                            player.damage(player.world, (player.world as? ServerWorld)?.damageSources?.magic() ?: player.damageSources.magic(), damage)
                        }
                    }
                    if (passive.expireTick - now <= 1L) {
                        player.heal(player.maxHealth * 0.30f)
                        player.sendMessage(Text.translatable("item.cresora.weapon.qianqiu_yeluo.passive_healed").formatted(Formatting.GREEN), true)
                    }
                }
                if (WeaponSkillService.hasStatus(player, "yoraku_manchisho_active")) {
                    val state = qiucanStackStates.get(player.uuid)
                    if (state == null || state.stacks <= 0) {
                        yorakuManchishoActiveStates.remove(player.uuid)
                        yorakuPowerStates.remove(player.uuid)
                        player.sendMessage(Text.translatable("item.cresora.weapon.qianqiu_yeluo.yoraku_ended").formatted(Formatting.GRAY), true)
                    }
                }
            }
        }

        on_damage_dealt {
            execute {
                if (isTrueDamage) return@execute
                val world = player.world as? ServerWorld ?: return@execute

                if (WeaponSkillService.hasStatus(player, "passive_state")) {
                    val missingHp = (player.maxHealth - player.health).coerceAtLeast(0.0f)
                    val boost = (missingHp / 2.0f * 0.01f).coerceAtMost(0.20f)
                    if (boost > 0) {
                        target.damage(world, world.damageSources.magic(), amount * boost)
                    }
                }

                if (WeaponSkillService.hasStatus(player, "jingtian_state")) {
                    val zansouBoost = if (WeaponSkillService.hasStatus(player, "zansou_mode")) 1.5f else 1.0f
                    target.damage(world, world.damageSources.magic(), (amount * 0.15f) * zansouBoost)
                    if (world.random.nextDouble() < 0.30) {
                        WeaponSkillService.applyMark(target, "root", 120L)
                        target.addStatusEffect(StatusEffectInstance(StatusEffects.SLOWNESS, 120, 255, false, false, true))
                    }
                }

                if (WeaponSkillService.hasStatus(player, "zansou_mode")) {
                    WeaponSkillService.applyMark(target, "lux", 200L)
                }

                if (WeaponSkillService.hasStatus(player, "yoraku_manchisho_active")) {
                    val aoeRange = 4.5
                    val baseDamage = WeaponCombatSupport.attackDamage(definition, data).toFloat()
                    world.getEntitiesByClass(LivingEntity::class.java, player.boundingBox.expand(aoeRange)) { it.isAlive && it != player }
                        .forEach { entity ->
                             entity.damage(world, world.damageSources.magic(), baseDamage * 1.5f)
                        }

                    val state = qiucanStackStates.get(player.uuid)
                    if (state != null && state.stacks >= 4) {
                        state.stacks -= 4
                        player.heal(player.maxHealth * 0.04f)
                        val powerState = yorakuPowerStates.getOrPut(player.uuid) { YorakuPowerState(0L, 0) }
                        powerState.expireTick = world.time + 300L
                        powerState.stacks = (powerState.stacks + 4).coerceAtMost(100)
                        player.sendMessage(Text.translatable("item.cresora.weapon.qianqiu_yeluo.yoraku_hit", state.stacks, powerState.stacks).formatted(Formatting.GOLD), true)
                    }
                }
            }
        }
    }

    sub_skill "Danrai" {
        effect_id: "danrai"
        icon: "minecraft:lightning_rod"
        on_activate {
            start_cooldown(34s)
            add_buff("passive_state", 1)
            add_buff("jingtian_state", 1)
            close_skill_menu()
            send_localized_message("item.cresora.weapon.qianqiu_yeluo.danrai_activated", "YELLOW")
        }
    }

    sub_skill "Zansou" {
        effect_id: "zansou"
        icon: "minecraft:blue_ice"
        on_activate {
            execute {
                val cost = player.maxHealth * 0.20f;
                player.damage(player.world, player.damageSources.magic(), cost);
            }
            start_cooldown(30s)
            add_buff("passive_state", 1)
            add_buff("zansou_mode", 1)
            execute {
                val jt = jingtianStateStates.get(player.uuid);
                if (jt != null) {
                    jt.expireTick = WeaponSkillService.currentWorldTime(player) + 40 * 20L;
                }
            }
            close_skill_menu()
            send_localized_message("item.cresora.weapon.qianqiu_yeluo.zansou_activated", "AQUA")
        }
    }

    sub_skill "Yoraku Manchisho" {
        effect_id: "yoraku_manchisho"
        icon: "minecraft:map"
        on_activate {
            execute {
                val state = qiucanStackStates.get(player.uuid);
                if (state == null || state.stacks < 20) {
                    player.sendMessage(Text.translatable("item.cresora.weapon.qianqiu_yeluo.insufficient_stacks").formatted(Formatting.RED), true);
                    return@execute;
                }

                val buffState = yorakuManchishoActiveStates.getOrPut(player.uuid) {
                    YorakuManchishoActiveState(0L, 0)
                }
                buffState.expireTick = WeaponSkillService.currentWorldTime(player) + 60 * 20L;
                buffState.stacks = 1;

                HotbarOverrideService.restoreHotbar(player);
            }
            send_localized_message("item.cresora.weapon.qianqiu_yeluo.yoraku_activated", "GOLD")
        }
    }

    translations {
        en_us {
            name: "Qianqiu, Yeluo"
            skill_name: "Rougan Sword Styles"
            "spirit.cresora.qianqiu_yeluo.awakening": "Awakens when you stop calling autumn an ending and learn to hear what it preserves."
            "spirit.cresora.qianqiu_yeluo.voice.first_contact": "Autumn is not an ending. It is the color things wear before they speak plainly."
            "spirit.cresora.qianqiu_yeluo.bond.1.title": "First Falling Leaf"
            "spirit.cresora.qianqiu_yeluo.bond.1.story": "She arrives with the hush of something beautiful already half on its way to loss."
            "spirit.cresora.qianqiu_yeluo.bond.2.title": "Hidden Thunder"
            "spirit.cresora.qianqiu_yeluo.bond.2.story": "Beneath her melancholy you hear the force she keeps restrained, waiting for the right wound."
            "spirit.cresora.qianqiu_yeluo.bond.3.title": "Frost on Old Branches"
            "spirit.cresora.qianqiu_yeluo.bond.3.story": "Her sorrow stops being fragile and reveals the endurance that carried it through many seasons."
            "spirit.cresora.qianqiu_yeluo.bond.4.title": "Bright Bitterness"
            "spirit.cresora.qianqiu_yeluo.bond.4.story": "She teaches you that grief can gleam without becoming false, and pain can sharpen without consuming."
            "spirit.cresora.qianqiu_yeluo.bond.5.title": "Unwithering Season"
            "spirit.cresora.qianqiu_yeluo.bond.5.story": "What should have fallen away remains, not as regret, but as strength carefully ripened."
            "spirit.cresora.qianqiu_yeluo.bond.6.title": "Thousand Autumns Unbound"
            "spirit.cresora.qianqiu_yeluo.bond.6.story": "At last she entrusts you with every season she endured, and none of them feel wasted."
            fragment_name: "Fragment of Qianqiu"
            sub_skill_danrai_name: "First Style: Danrai"
            sub_skill_zansou_name: "Second Style: Zansou"
            sub_skill_yoraku_manchisho_name: "Third Style: Yoraku Manchisho"
            "item.cresora.weapon.qianqiu_yeluo.danrai_activated": "First Style: Danrai - Jingtian State active!"
            "item.cresora.weapon.qianqiu_yeluo.zansou_activated": "Second Style: Zansou - Frost Severance active!"
            "item.cresora.weapon.qianqiu_yeluo.yoraku_activated": "Third Style: Yoraku Manchisho - Autumn Ending!"
            "item.cresora.weapon.qianqiu_yeluo.yoraku_hit": "Autumn Leaves: %s stacks | Bonus: %s stacks"
            "item.cresora.weapon.qianqiu_yeluo.yoraku_ended": "Autumn has passed."
            "item.cresora.weapon.qianqiu_yeluo.passive_healed": "Skill ended - Life restored."
            "item.cresora.weapon.qianqiu_yeluo.insufficient_stacks": "Insufficient Qiucan stacks (Need 20)."
        }
        ja_jp {
            name: "千秋、叶落"
            skill_name: "琅玕剣法"
            "spirit.cresora.qianqiu_yeluo.awakening": "秋を終わりと呼ぶのをやめ、その中に残されるものへ耳を澄ませた時に目覚める。"
            "spirit.cresora.qianqiu_yeluo.voice.first_contact": "秋は終わりではないわ。ものごとが本音を語る前にまとう色なの。"
            "spirit.cresora.qianqiu_yeluo.bond.1.title": "初めて落ちる葉"
            "spirit.cresora.qianqiu_yeluo.bond.1.story": "彼女は、美しいものがすでに喪失へ向かい始めている時の静けさをまとって現れる。"
            "spirit.cresora.qianqiu_yeluo.bond.2.title": "秘めた雷"
            "spirit.cresora.qianqiu_yeluo.bond.2.story": "その憂いの底に、彼女が正しい痛みのためだけに抑えてきた力が響いている。"
            "spirit.cresora.qianqiu_yeluo.bond.3.title": "古枝の霜"
            "spirit.cresora.qianqiu_yeluo.bond.3.story": "彼女の悲しみは脆さではなく、幾度もの季節を越えてきた持続のかたちだと分かる。"
            "spirit.cresora.qianqiu_yeluo.bond.4.title": "冴える苦み"
            "spirit.cresora.qianqiu_yeluo.bond.4.story": "嘆きは偽りなく輝けるし、痛みは身を焼かずに刃を研げるのだと彼女は教える。"
            "spirit.cresora.qianqiu_yeluo.bond.5.title": "朽ちぬ季節"
            "spirit.cresora.qianqiu_yeluo.bond.5.story": "落ちて消えるはずのものは、後悔ではなく熟した力としてなお留まり続ける。"
            "spirit.cresora.qianqiu_yeluo.bond.6.title": "千秋解放"
            "spirit.cresora.qianqiu_yeluo.bond.6.story": "ついに彼女は、耐え抜いてきたすべての季節をあなたへ預け、そのどれ一つも無駄ではなかったと知る。"
            fragment_name: "千秋の欠片"
            sub_skill_danrai_name: "第一式：断雷"
            sub_skill_zansou_name: "第二式：斬霜"
            sub_skill_yoraku_manchisho_name: "第三式：叶落満地傷"
            "item.cresora.weapon.qianqiu_yeluo.danrai_activated": "第一式：断雷 — 浄天状態展開！"
            "item.cresora.weapon.qianqiu_yeluo.zansou_activated": "第二式：斬霜 — 霜削状態展開！"
            "item.cresora.weapon.qianqiu_yeluo.yoraku_activated": "第三式：叶落満地傷 — 秋の終焉！"
            "item.cresora.weapon.qianqiu_yeluo.yoraku_hit": "秋葉：残り %s 層 | 強化：累積 %s 層"
            "item.cresora.weapon.qianqiu_yeluo.yoraku_ended": "秋は過ぎ去った。"
            "item.cresora.weapon.qianqiu_yeluo.passive_healed": "技能終了：生命が回復した。"
            "item.cresora.weapon.qianqiu_yeluo.insufficient_stacks": "「秋残」スタックが足りません（必要：20層）"
            buff_passive_state_name: "受動状態"
            buff_qiucan_stack_name: "秋残"
            buff_jingtian_state_name: "浄天"
            buff_zansou_mode_name: "斬霜"
            buff_yoraku_power_name: "叶落"
            "item.cresora.weapon.skill.buff.passive_state.gained": "効果獲得: %s"
            "item.cresora.weapon.skill.buff.jingtian_state.gained": "第一式「断雷」: %s 展開 (%s 層)"
        }
        zh_cn {
            name: "千秋、叶落"
            skill_name: "琅玕剑法"
            "spirit.cresora.qianqiu_yeluo.awakening": "当你不再把秋天称作终结，而开始倾听它留下了什么时，她便苏醒。"
            "spirit.cresora.qianqiu_yeluo.voice.first_contact": "秋不是结束。那只是万物在坦白之前披上的颜色。"
            "spirit.cresora.qianqiu_yeluo.bond.1.title": "初坠之叶"
            "spirit.cresora.qianqiu_yeluo.bond.1.story": "她带着一种静意而来，像美好之物已开始朝失去倾斜的那一刻。"
            "spirit.cresora.qianqiu_yeluo.bond.2.title": "藏起的雷"
            "spirit.cresora.qianqiu_yeluo.bond.2.story": "在她的忧色之下，你听见那股只为正确伤口而保留的力量。"
            "spirit.cresora.qianqiu_yeluo.bond.3.title": "旧枝寒霜"
            "spirit.cresora.qianqiu_yeluo.bond.3.story": "她的悲伤不再显得脆弱，而更像穿过无数季节后仍旧不折的耐性。"
            "spirit.cresora.qianqiu_yeluo.bond.4.title": "明亮的苦涩"
            "spirit.cresora.qianqiu_yeluo.bond.4.story": "她让你明白，哀伤可以发亮而不虚假，痛楚也能锋利而不吞没自己。"
            "spirit.cresora.qianqiu_yeluo.bond.5.title": "不凋的季节"
            "spirit.cresora.qianqiu_yeluo.bond.5.story": "本该落尽的东西仍留着，不是因为执念，而是因为它们终于被酿成了力量。"
            "spirit.cresora.qianqiu_yeluo.bond.6.title": "千秋解缚"
            "spirit.cresora.qianqiu_yeluo.bond.6.story": "最后，她把自己熬过的每一个季节都交到你手里，而你知道它们没有一个被白白浪费。"
            fragment_name: "千秋碎片"
            sub_skill_danrai_name: "第一式：断雷"
            sub_skill_zansou_name: "第二式：斩霜"
            sub_skill_yoraku_manchisho_name: "第三式：叶落满地伤"
            "item.cresora.weapon.qianqiu_yeluo.danrai_activated": "第一式：断雷 — 浄天状态已开启！"
            "item.cresora.weapon.qianqiu_yeluo.zansou_activated": "第二式：斩霜 — 霜削状态已开启！"
            "item.cresora.weapon.qianqiu_yeluo.yoraku_activated": "第三式：叶落满地伤 — 秋之终焉！"
            "item.cresora.weapon.qianqiu_yeluo.yoraku_hit": "秋叶：剩余 %s 层 | 强化：累计 %s 层"
            "item.cresora.weapon.qianqiu_yeluo.yoraku_ended": "秋已逝。"
            "item.cresora.weapon.qianqiu_yeluo.passive_healed": "技能结束：生命已恢复。"
            "item.cresora.weapon.qianqiu_yeluo.insufficient_stacks": "「秋残」层数不足（需要20层）"
            buff_passive_state_name: "被动状态"
            buff_qiucan_stack_name: "秋残"
            buff_jingtian_state_name: "浄天"
            buff_zansou_mode_name: "斩霜"
            buff_yoraku_power_name: "叶落"
            "item.cresora.weapon.skill.buff.passive_state.gained": "获得効果: %s"
            "item.cresora.weapon.skill.buff.jingtian_state.gained": "第一式「断雷」: %s 开启 (%s 层)"
        }
        lzh {
            name: "千秋，葉落"
            skill_name: "琅玕劍法"
            "spirit.cresora.qianqiu_yeluo.awakening": "不復以秋為終，而能聽其所留者，其靈乃寤。"
            "spirit.cresora.qianqiu_yeluo.voice.first_contact": "秋非終也。萬物將吐其實之前，姑先衣此色耳。"
            "spirit.cresora.qianqiu_yeluo.bond.1.title": "初墜之葉"
            "spirit.cresora.qianqiu_yeluo.bond.1.story": "彼來時之靜，如美物既向失去微傾之一瞬。"
            "spirit.cresora.qianqiu_yeluo.bond.2.title": "藏雷"
            "spirit.cresora.qianqiu_yeluo.bond.2.story": "其憂色之下，可聞彼所蓄之力，惟待當受之創而發。"
            "spirit.cresora.qianqiu_yeluo.bond.3.title": "故枝寒霜"
            "spirit.cresora.qianqiu_yeluo.bond.3.story": "其悲不復為脆，乃歷諸時序而不折之忍。"
            "spirit.cresora.qianqiu_yeluo.bond.4.title": "明苦"
            "spirit.cresora.qianqiu_yeluo.bond.4.story": "彼使爾知，哀可明而不妄，痛可利而不噬其身。"
            "spirit.cresora.qianqiu_yeluo.bond.5.title": "不凋之時"
            "spirit.cresora.qianqiu_yeluo.bond.5.story": "本當盡落者猶留焉，非由執著，乃由其終釀為力。"
            "spirit.cresora.qianqiu_yeluo.bond.6.title": "千秋解縛"
            "spirit.cresora.qianqiu_yeluo.bond.6.story": "終則彼以所經諸時序盡付於爾，而知其無一徒然。"
            fragment_name: "千秋之片"
            sub_skill_danrai_name: "第一式：斷雷"
            sub_skill_zansou_name: "第二式：斬霜"
            sub_skill_yoraku_manchisho_name: "第三式：葉落滿地傷"
            "item.cresora.weapon.qianqiu_yeluo.danrai_activated": "第一式：斷雷 — 淨天啟矣！"
            "item.cresora.weapon.qianqiu_yeluo.zansou_activated": "第二式：斬霜 — 霜削啟矣！"
            "item.cresora.weapon.qianqiu_yeluo.yoraku_activated": "第三式：葉落滿地傷 — 秋終焉！"
            "item.cresora.weapon.qianqiu_yeluo.yoraku_hit": "秋葉：餘 %s 重 | 益：累 %s 重"
            "item.cresora.weapon.qianqiu_yeluo.yoraku_ended": "秋既終。"
            "item.cresora.weapon.qianqiu_yeluo.passive_healed": "技竟，氣既復。"
            "item.cresora.weapon.qianqiu_yeluo.insufficient_stacks": "「秋殘」不足（需二十重）"
        }
    }
}
